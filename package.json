{
  "name": "Webseite Malerbetrieb Kringelis",
  "version": "0.5.1",
  "description": "Astro and Tailwindcss boilerplate",
  "author": "Alpine Data Ventures im Auftrag von Malerbetrieb Kringelis",
  "license": "keine",
  "packageManager": "npm@12.2.3",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node scripts/themeGenerator.js --watch\" \"astro dev\"",
    "build": "node scripts/themeGenerator.js && astro build && node scripts/llmsGenerator.js",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier -w ./src",
    "generate-llms": "node scripts/llmsGenerator.js",
    "remove-darkmode": "node scripts/removeDarkmode.js && npm format",
    "deploy:cf-workers": "npm run build && wrangler deploy",
    "preview:cf-workers": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/react": "7.1.9",
    "@astrojs/sitemap": "3.7.6",
    "@digi4care/astro-google-tagmanager": "^2.1.0",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "astro": "7.4.13",
    "astro-auto-import": "^0.6.0",
    "astro-swiper": "^2.11.0",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.3.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "glob": "^14.0.6",
    "node-html-parser": "^9.0.7",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.3.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "turndown": "^7.2.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.168.0"
  },
  "overrides": {
    "typescript": "$typescript",
    "astro": "$astro"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
