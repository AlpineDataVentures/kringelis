---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";

const contactIndex = await getListPage("kontakt", "-index");
const { title, description, meta_title, image } = contactIndex.data;

const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && contactIndex.data.draft) {
  return Astro.redirect("/404");
}
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} />
  <section class="section-sm">
    <div class="container">
      <div class="row">
        <div class="mx-auto md:col-10 lg:col-6">
          <h2 class="h3 mb-6">Kontakt</h2>
          <address class="not-italic leading-8">
            <div>Winzererstraße 69</div>
            <div>80797 München</div>
            <div>
              <a href="mailto:info@malerbetrieb-kringelis.de">
                info@malerbetrieb-kringelis.de
              </a>
            </div>
            <div>
              Mobil:
              <a href="tel:+491703151138">0170 3151138</a>
            </div>
          </address>
        </div>
      </div>
    </div>
  </section>
</Base>
