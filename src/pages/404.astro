---
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import Base from "@/layouts/Base.astro";

const { contact } = config;
---

<Base
  title="Seite nicht gefunden"
  description="Die Seite, die Sie suchen, wurde nicht gefunden."
  noindex={true}
>
  <section class="section-sm">
    <div class="container max-w-2xl text-center">
      <span class="eyebrow">Fehler 404</span>
      <h1 class="h2 mb-4">Diese Seite gibt es nicht (mehr)</h1>
      <p class="mb-8 text-lg">
        Vielleicht sind Sie über einen alten Link gekommen – unsere Website ist
        neu. Den Malerbetrieb Kringelis gibt es natürlich weiterhin.
      </p>
      <div class="mb-10 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">Zur Startseite</a>
        <a href={`tel:${contact.phone_link}`} class="btn btn-outline-primary">
          Anrufen: {contact.phone_display}
        </a>
      </div>
      <nav aria-label="Bereiche der Startseite">
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2">
          {
            menu.main.map((item) => (
              <li>
                <a class="footer-link" href={item.url}>{item.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Base>
