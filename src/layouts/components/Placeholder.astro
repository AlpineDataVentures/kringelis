---
// Visible stand-in for photos that are still missing (team, hero).
// Replace by setting the image path in the content file; search for
// "data-placeholder" to find all remaining placeholders.
interface Props {
  label: string;
  hint?: string;
  class?: string;
}

const { label, hint, class: className = "" } = Astro.props;
---

<div class={`placeholder-img ${className}`} role="img" aria-label={`Platzhalter: ${label}`} data-placeholder>
  <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.8l1.2-1.8A1.5 1.5 0 0 1 9.8 3.5h4.4a1.5 1.5 0 0 1 1.3.7L16.7 6h1.8A2.5 2.5 0 0 1 21 8.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5v-9Z" />
    <circle cx="12" cy="12.5" r="3.5" />
  </svg>
  <p class="font-secondary text-lg font-semibold">{label}</p>
  {hint && <p class="max-w-xs text-sm">{hint}</p>}
</div>
