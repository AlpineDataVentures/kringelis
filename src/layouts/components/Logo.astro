---
// Logo draft "Variante A" (docs/logo-entwuerfe), pending approval by Manuel.
// Inline SVG: uses the site's self-hosted fonts and theme colors, so it adapts
// to dark mode without a second image file.
const { class: className = "", subline = "Malermeister · München" } =
  Astro.props as { class?: string; subline?: string };
---

<a
  href="/"
  class={`navbar-brand inline-flex items-center ${className}`}
  aria-label="Malerbetrieb Kringelis – zur Startseite"
>
  <svg
    viewBox="4 4 492 160"
    class="h-full w-auto"
    aria-hidden="true"
    focusable="false"
  >
    <g transform="translate(85 85)">
      <ellipse
        rx="72"
        ry="46"
        transform="rotate(-10)"
        class="fill-primary dark:fill-darkmode-primary"></ellipse>
      <g transform="rotate(-52)">
        <path d="M-20 -3.2 L92 -1.6 Q96 0 92 1.6 L-20 3.6 Z" class="fill-cream"></path>
        <rect x="-34" y="-5" width="15" height="10" rx="1.5" class="fill-steel"></rect>
        <path
          d="M-34 -5 C-50 -6 -66 -2 -76 4 C-64 6 -50 5 -34 5 Z"
          class="fill-cream"></path>
        <path
          d="M-76 4 C-70 1 -60 0 -52 1 C-60 4 -68 5 -76 4 Z"
          class="fill-primary dark:fill-darkmode-primary"></path>
      </g>
    </g>
    <text
      x="178"
      y="96"
      class="logo-wordmark fill-text-dark dark:fill-darkmode-text-dark">Kringelis</text
    >
    <text
      x="181"
      y="128"
      class="logo-subline fill-primary dark:fill-darkmode-primary"
      >{subline.toUpperCase()}</text
    >
  </svg>
</a>

<style>
  .logo-wordmark {
    font-family: var(--font-secondary);
    font-weight: 650;
    font-size: 62px;
    letter-spacing: -0.5px;
  }
  .logo-subline {
    font-family: var(--font-primary);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 4px;
  }
</style>
