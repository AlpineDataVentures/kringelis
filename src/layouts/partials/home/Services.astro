---
import ImageMod from "@/components/ImageMod.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  data: {
    eyebrow: string;
    title: string;
    intro?: string;
    items: {
      title: string;
      text: string;
      detail: string;
      image: string;
      image_alt: string;
    }[];
    highlight: {
      eyebrow: string;
      title: string;
      text: string;
      link: string;
      link_label: string;
    };
  };
}

const { data } = Astro.props;
---

<section id="leistungen" class="section" aria-labelledby="leistungen-title">
  <div class="container">
    <SectionHeading id="leistungen" eyebrow={data.eyebrow} title={data.title} intro={data.intro} />

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        data.items.map((item) => (
          <article class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-body transition-shadow hover:shadow-lg dark:border-darkmode-border dark:bg-darkmode-light">
            <div class="overflow-hidden">
              <ImageMod
                src={item.image}
                alt={item.image_alt}
                width={800}
                height={600}
                widths={[400, 600, 800]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                fit="cover"
                loading="lazy"
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="flex grow flex-col p-6">
              <h3 class="h4 mb-3">{item.title}</h3>
              <p class="mb-4">{item.text}</p>
              <p class="mt-auto border-t border-border pt-4 text-sm text-text-light dark:border-darkmode-border dark:text-darkmode-text-light">
                <span class="font-semibold text-text-dark dark:text-darkmode-text-dark">So gehen wir vor: </span>
                {item.detail}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 grid items-center gap-6 rounded-2xl bg-primary p-8 text-white md:grid-cols-[1fr_auto] md:p-12 dark:bg-darkmode-light dark:ring-1 dark:ring-darkmode-primary">
      <div>
        <span class="mb-2 block text-sm font-semibold tracking-[0.2em] text-cream uppercase">
          {data.highlight.eyebrow}
        </span>
        <h3 class="h3 mb-3 text-white">{data.highlight.title}</h3>
        <p class="max-w-2xl text-white/90 dark:text-darkmode-text">{data.highlight.text}</p>
      </div>
      <a href={data.highlight.link} class="btn btn-light whitespace-nowrap">
        {data.highlight.link_label}
      </a>
    </div>
  </div>
</section>
