---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
  center?: boolean;
}

const { id, eyebrow, title, intro, center = false } = Astro.props;
---

<div class={`mb-12 max-w-3xl ${center ? "mx-auto text-center" : ""}`}>
  <span class="eyebrow">{eyebrow}</span>
  <h2 id={`${id}-title`}>{title}</h2>
  {intro && <p class="mt-4 text-lg">{intro}</p>}
</div>
