---
import ImageMod from "@/components/ImageMod.astro";
import Placeholder from "@/components/Placeholder.astro";
import { markdownify } from "@/lib/utils/textConverter";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  data: {
    eyebrow: string;
    title: string;
    intro?: string;
    content: string;
    values: { title: string; text: string }[];
    team: {
      name: string;
      role: string;
      text: string;
      image?: string;
      image_alt?: string;
    }[];
    timeline: { year: string; text: string }[];
    partners: string;
  };
}

const { data } = Astro.props;
---

<section id="ueber-uns" class="section" aria-labelledby="ueber-uns-title">
  <div class="container">
    <SectionHeading
      id="ueber-uns"
      eyebrow={data.eyebrow}
      title={data.title}
      intro={data.intro}
    />

    <!-- Team: the people who come to your home -->
    <ul class="mb-16 grid gap-8 sm:grid-cols-2 lg:max-w-4xl">
      {data.team.map((person) => (
        <li>
          <figure>
            {person.image ? (
              <ImageMod
                src={person.image}
                alt={person.image_alt ?? person.name}
                width={800}
                height={1000}
                widths={[400, 600, 800]}
                sizes="(min-width: 640px) 40vw, 100vw"
                fit="cover"
                loading="lazy"
                class="aspect-4/5 w-full rounded-2xl object-cover"
              />
            ) : (
              <Placeholder
                class="aspect-4/5"
                label={`Foto ${person.name.split(" ")[0]}`}
                hint="Porträt im Hochformat, gern bei der Arbeit"
              />
            )}
            <figcaption class="mt-4">
              <p class="font-secondary text-h5 font-semibold text-text-dark dark:text-darkmode-text-dark">
                {person.name}
              </p>
              <p class="font-semibold text-text-light dark:text-darkmode-text-light">
                {person.role}
              </p>
              <p class="mt-2">{person.text}</p>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div
          class="content text-lg"
          set:html={markdownify(data.content, true)}
        />

        <ul class="mt-10 grid gap-6 sm:grid-cols-3">
          {data.values.map((v) => (
            <li class="rounded-xl bg-light p-5 dark:bg-darkmode-light">
              <p class="font-secondary text-xl font-semibold text-text-dark dark:text-darkmode-text-dark">
                {v.title}
              </p>
              <p class="mt-1">{v.text}</p>
            </li>
          ))}
        </ul>

        <p class="mt-8">{data.partners}</p>
      </div>

      <aside class="lg:col-span-5" aria-label="Werdegang">
        <div class="rounded-2xl border border-border p-8 dark:border-darkmode-border">
          <h3 class="h4 mb-6">Werdegang</h3>
          <ol class="relative border-l-2 border-border dark:border-darkmode-border">
            {data.timeline.map((t) => (
              <li class="mb-7 ml-6 last:mb-0">
                <span class="absolute -left-2.25 mt-1.5 h-4 w-4 rounded-full border-2 border-body bg-primary dark:border-darkmode-body dark:bg-darkmode-primary" />
                <p class="font-secondary text-lg font-semibold text-text-dark dark:text-darkmode-text-dark">
                  {t.year}
                </p>
                <p>{t.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </aside>
    </div>
  </div>
</section>
