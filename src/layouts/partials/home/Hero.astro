---
import ImageMod from "@/components/ImageMod.astro";
import config from "@/config/config.json";

interface Props {
  data: {
    eyebrow: string;
    title: string;
    content: string;
    cta_secondary: string;
    image: string;
    image_alt: string;
  };
}

const { data } = Astro.props;
const { contact } = config;
---

<section id="start" class="relative overflow-hidden">
  <div class="container grid items-center gap-10 py-12 lg:grid-cols-12 lg:gap-14 lg:py-20">
    <div class="lg:col-span-6 xl:col-span-6">
      <span class="eyebrow">{data.eyebrow}</span>
      <h1 class="mb-6 text-h2-sm md:text-h2 xl:text-h1">{data.title}</h1>
      <p class="mb-8 max-w-xl text-lg">{data.content}</p>
      <div class="flex flex-wrap gap-3">
        <a href={`tel:${contact.phone_link}`} class="btn btn-primary">
          Jetzt anrufen: {contact.phone_display}
        </a>
        <a href="#kontakt" class="btn btn-outline-primary">{data.cta_secondary}</a>
      </div>
    </div>

    <div class="relative lg:col-span-6">
      <div class="overflow-hidden rounded-2xl shadow-xl">
        <ImageMod
          src={data.image}
          alt={data.image_alt}
          width={1200}
          height={1350}
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          fit="cover"
          loading="eager"
          fetchpriority="high"
          class="aspect-[8/9] h-full w-full object-cover"
        />
      </div>
      <div
        class="absolute -bottom-5 left-5 rounded-xl bg-body px-5 py-4 shadow-lg md:left-auto md:-right-4 dark:bg-darkmode-light"
      >
        <p class="font-secondary text-2xl leading-none font-semibold text-primary dark:text-darkmode-primary">
          Meisterbetrieb
        </p>
        <p class="mt-1 text-sm text-text-light dark:text-darkmode-text-light">
          seit {contact.founded} in {contact.district}
        </p>
      </div>
    </div>
  </div>
</section>
