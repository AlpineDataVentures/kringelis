---
import ImageMod from "@/components/ImageMod.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  data: {
    eyebrow: string;
    title: string;
    intro?: string;
    steps: { title: string; text: string }[];
    image: string;
    image_alt: string;
    business: { title: string; text: string; points: string[] };
  };
}

const { data } = Astro.props;
---

<section id="ablauf" class="section bg-light dark:bg-darkmode-light" aria-labelledby="ablauf-title">
  <div class="container">
    <SectionHeading id="ablauf" eyebrow={data.eyebrow} title={data.title} intro={data.intro} />

    <ol class="mb-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        data.steps.map((step, i) => (
          <li class="rounded-2xl bg-body p-6 dark:bg-darkmode-body">
            <span
              class="mb-4 flex h-11 w-11 items-center justify-center rounded-full bg-primary font-secondary text-lg font-semibold text-white dark:bg-darkmode-primary dark:text-darkmode-body"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="h5 mb-2">{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div class="overflow-hidden rounded-2xl">
        <ImageMod
          src={data.image}
          alt={data.image_alt}
          width={1000}
          height={750}
          widths={[500, 750, 1000]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          fit="cover"
          loading="lazy"
          class="aspect-[4/3] w-full object-cover"
        />
      </div>
      <div>
        <h3 class="h3 mb-4">{data.business.title}</h3>
        <p class="mb-6 text-lg">{data.business.text}</p>
        <ul class="space-y-3">
          {
            data.business.points.map((p) => (
              <li class="flex gap-3">
                <svg class="mt-1 h-5 w-5 flex-none text-primary dark:text-darkmode-primary" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
                </svg>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
