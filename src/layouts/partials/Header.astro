---
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";

export interface NavigationLink {
  name: string;
  url: string;
}

const { main }: { main: NavigationLink[] } = menu;
const { contact, settings } = config;
---

<header
  class={`header z-30 ${settings.sticky_header ? "sticky top-0" : ""}`}
  data-header
>
  <nav class="navbar container" aria-label="Hauptnavigation">
    <Logo class="order-0 h-12 md:h-14" />

    <!-- mobile menu toggle (CSS-only, enhanced by script below) -->
    <input id="nav-toggle" type="checkbox" class="peer hidden" />

    <div class="order-1 ml-auto flex items-center gap-3 lg:order-2 lg:ml-6">
      <a
        href={`tel:${contact.phone_link}`}
        class="btn btn-primary btn-sm inline-flex items-center gap-2"
        aria-label={`Anrufen: ${contact.phone_display}`}
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          ><path
            d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"
          ></path></svg
        >
        <span class="sm:hidden">Anrufen</span>
        <span class="hidden sm:inline">{contact.phone_display}</span>
      </a>
      <label
        for="nav-toggle"
        class="nav-toggler lg:hidden"
        aria-label="Menü öffnen oder schließen"
      >
        <svg class="nav-icon-open h-6 w-6" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"></path>
        </svg>
        <svg class="nav-icon-close hidden h-6 w-6" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M4.3 2.9 10 8.6l5.7-5.7 1.4 1.4-5.7 5.7 5.7 5.7-1.4 1.4-5.7-5.7-5.7 5.7-1.4-1.4 5.7-5.7-5.7-5.7z"></path>
        </svg>
      </label>
    </div>

    <ul
      id="nav-menu"
      class="navbar-nav order-3 hidden w-full peer-checked:block lg:order-1 lg:ml-auto lg:flex lg:w-auto lg:gap-1"
    >
      {
        main.map((item) => (
          <li class="nav-item">
            <a href={item.url} class="nav-link" data-nav-link>
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Anchor navigation for the single page:
  // - calm, eased scrolling with a capped duration (native smooth scrolling
  //   rushes through ~8000 px and cannot be tuned)
  // - lands the section heading right below the sticky header (measured live)
  // - scroll spy that does not flicker through all sections while scrolling
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.getElementById("nav-toggle") as HTMLInputElement | null;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const GAP = 24; // px between header and section heading

  const navLinks = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]").forEach((link) => {
    const hash = new URL(link.href).hash;
    if (hash) navLinks.set(hash.slice(1), link);
  });

  const setActive = (id: string | null) =>
    navLinks.forEach((link, key) => {
      const active = key === id;
      link.classList.toggle("active", active);
      if (active) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    });

  // Target: the section's label/heading, so the section padding is not wasted
  const targetY = (section: HTMLElement) => {
    const anchor = section.querySelector<HTMLElement>(".eyebrow, h1, h2") ?? section;
    const headerHeight = header?.offsetHeight ?? 0;
    const y = anchor.getBoundingClientRect().top + window.scrollY - headerHeight - GAP;
    return section.id === "start" ? 0 : Math.max(0, y);
  };

  let programmatic = false;
  let frame = 0;
  const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  const scrollToSection = (section: HTMLElement, animate: boolean) => {
    cancelAnimationFrame(frame);
    setActive(section.id);
    const startY = window.scrollY;
    const distance = targetY(section) - startY;

    if (!animate || reduceMotion.matches || Math.abs(distance) < 2) {
      window.scrollTo(0, targetY(section));
      return;
    }

    programmatic = true;
    // 450-900 ms depending on distance: calm, but never sluggish
    const duration = Math.min(900, Math.max(450, Math.abs(distance) / 6));
    const start = performance.now();

    const step = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      window.scrollTo(0, startY + distance * easeInOutCubic(t));
      if (t < 1) {
        frame = requestAnimationFrame(step);
      } else {
        // correct if layout changed meanwhile (fonts, lazy images)
        window.scrollTo(0, targetY(section));
        programmatic = false;
      }
    };
    frame = requestAnimationFrame(step);
  };

  // Same-page anchor links anywhere on the page (menu, buttons, footer)
  document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
    if (!link || event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey) return;
    const url = new URL(link.href);
    if (url.pathname !== location.pathname || !url.hash) return;
    const section = document.getElementById(decodeURIComponent(url.hash.slice(1)));
    if (!section) return;

    event.preventDefault();
    if (toggle) toggle.checked = false; // close mobile menu
    history.pushState(null, "", url.hash);
    scrollToSection(section, true);
    // move keyboard focus to the target for screen reader / keyboard users
    section.setAttribute("tabindex", "-1");
    section.focus({ preventScroll: true });
  });

  // Coming from another page (e.g. /impressum -> /#ablauf): fix the landing position
  const fromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const section = id ? document.getElementById(id) : null;
    if (section) scrollToSection(section, false);
  };
  window.addEventListener("load", fromHash);
  window.addEventListener("popstate", fromHash);

  // Scroll spy (only on the page that contains the sections)
  const sections = [...navLinks.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length && "IntersectionObserver" in window) {
    const visible = new Map<string, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => visible.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0));
        if (programmatic) return; // keep the clicked item highlighted while scrolling
        const best = [...visible.entries()].sort((a, b) => b[1] - a[1])[0];
        setActive(best && best[1] > 0 ? best[0] : null);
      },
      { rootMargin: "-30% 0px -50% 0px", threshold: [0, 0.25, 0.5, 1] },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
