---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { humanize, softHyphens } from "@/lib/utils/textConverter";

const { title = "" }: { title?: string } = Astro.props;
---

<section>
  <div class="container text-center">
    <div
      class="rounded-2xl bg-linear-to-b from-body to-light px-4 py-10 md:px-8 md:py-14 dark:from-darkmode-body dark:to-darkmode-light"
    >
      <h1 class="text-h2-sm md:text-h1" set:text={softHyphens(humanize(title))} />
      <Breadcrumbs className="mt-6" />
    </div>
  </div>
</section>
