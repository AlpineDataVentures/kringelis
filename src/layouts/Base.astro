---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { THEME_INIT_SCRIPT } from "@/lib/themeInit.mjs";
import { Font } from "astro:assets";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
}

// destructure frontmatter
const { title, meta_title, description, image, noindex, canonical } =
  Astro.props;

// canonical URL: explicit value from frontmatter, otherwise current path on the main domain
const canonicalURL =
  canonical ?? new URL(Astro.url.pathname, config.site.base_url).href;
---

<!doctype html>
<html lang="de">
  <head>
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- apply dark mode before first paint (no flash); preference is only kept in localStorage, no cookies -->
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <!-- theme meta -->
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content={theme.colors.default.theme_color.body}
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content={theme.colors.darkmode.theme_color.body}
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    <link rel="canonical" href={canonicalURL} />

    <!-- index robots -->
    <!-- for branch-deploys do NOT allow INDEXing, nor let crawler follow links -->
    {
      process.env.CONTEXT === "branch-deploy" && (
        <meta name="robots" content="noindex,nofollow" />
      )
    }
    <!-- for prod-deploys check index variable, but always let crawler follow links. Recommendation by SEO experts -->
    {
      process.env.CONTEXT === "production" && noindex && (
        <meta name="robots" content="noindex,follow" />
      )
    }
    {
      process.env.CONTEXT === "production" && !noindex && (
        <meta name="robots" content="index,follow" />
      )
    }

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />


    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={config.site.title} />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- og-image -->
    <meta
      property="og:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />

    <!-- twitter-image -->
    <meta
      name="twitter:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex flex-col min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-body focus:px-4 focus:py-2 focus:shadow"
      >Zum Inhalt springen</a
    >
    <Header />
    <main class="grow" id="main-content">
      <slot />
    </main>
    <Footer />
    <TwSizeIndicator />
  </body>
</html>
